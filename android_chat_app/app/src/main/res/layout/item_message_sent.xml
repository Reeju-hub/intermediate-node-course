<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <TextView
        android:id="@+id/tvMessageContentSent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:background="@drawable/bg_message_sent" 
        android:padding="10dp"
        android:textColor="@android:color/white"
        android:text="This is a sent message." />

    <TextView
        android:id="@+id/tvTimestampSent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="10sp"
        android:textColor="@color/grey_timestamp" 
        android:layout_alignEnd="@id/tvMessageContentSent"
        android:layout_below="@id/tvMessageContentSent"
        android:layout_marginTop="2dp"
        android:text="10:00 AM"/>
</RelativeLayout>
